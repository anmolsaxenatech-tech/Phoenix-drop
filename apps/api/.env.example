# API Server Port
PORT=3001

# Environment
NODE_ENV=development

# Allowed CORS Origins (comma-separated, e.g. https://phoenix-drop.vercel.app,http://localhost:5173)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database URL (Neon Free Tier or local PostgreSQL)
# If omitted or unavailable, an in-memory fallback store is automatically used.
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Best-Effort Public STUN Servers (strictly free, comma-separated)
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302"
